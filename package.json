{
  "name": "@theqrl/cli",
  "description": "QRL CLI functions",
  "version": "1.11.3",
  "author": "JP Lomas <jp@theqrl.org>, The QRL Foundation",
  "bin": {
    "qrl-cli": "./bin/run"
  },
  "bugs": "https://github.com/theqrl/qrl-cli/issues",
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.7.15",
    "@oclif/command": "1.8.36",
    "@oclif/config": "1.18.17",
    "@oclif/plugin-help": "2.2.3",
    "@theqrl/explorer-helpers": "2.8.2",
    "@theqrl/qrl-proto-sha256": "3.5.0",
    "@theqrl/qrlbase.proto": "1.1.1",
    "@theqrl/validate-qrl-address": "1.1.0",
    "aes-js": "3.1.2",
    "bech32": "1.1.4",
    "bignumber.js": "9.3.1",
    "cli-ux": "5.6.7",
    "conf": "10.2.0",
    "crypto-js": "4.2.0",
    "eccrypto": "1.1.6",
    "kleur": "3.0.3",
    "moment": "2.30.1",
    "ora": "3.4.0",
    "prompts": "2.4.2",
    "qrcode-terminal": "0.12.0",
    "qrllib": "1.2.7",
    "tmp": "0.2.7",
    "util": "0.12.5"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.29.7",
    "@oclif/dev-cli": "1.26.10",
    "@oclif/test": "1.2.9",
    "@semantic-release/git": "10.0.1",
    "@yao-pkg/pkg": "6.22.0",
    "chai": "4.5.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-import": "2.32.0",
    "globby": "10.0.2",
    "mocha": "11.8.0",
    "nyc": "18.0.0",
    "semantic-release": "25.0.9"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "/assets",
    "/bin",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json",
    "/scripts",
    "/src"
  ],
  "homepage": "https://github.com/theqrl/qrl-cli",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "src/index.js",
  "oclif": {
    "macos": {
      "identifier": "com.theqrl.qrl-cli"
    },
    "commands": "./src/commands",
    "bin": "qrl-cli",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "repository": "theqrl/qrl-cli",
  "nyc": {
    "reporter": [
      "text",
      "lcov"
    ],
    "report-dir": "coverage",
    "exclude": [
      "test/**",
      "scripts/**",
      "dist/**",
      "assets/**",
      "coverage/**"
    ]
  },
  "scripts": {
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "postinstall": "node scripts/postinstall.js",
    "postpack": "rm -f oclif.manifest.json",
    "posttest": "eslint .",
    "prepack": "oclif-dev manifest && oclif-dev readme",
    "test": "nyc mocha --require test/hooks.js --forbid-only -t 240000 \"test/**/*.test.js\"",
    "coverage": "nyc --reporter=text --reporter=html --reporter=lcov mocha --require test/hooks.js --forbid-only -t 240000 \"test/**/*.test.js\"",
    "coverage:report": "nyc report --reporter=text --reporter=html",
    "test-balance": "nyc mocha --forbid-only -t 50000 \"test/commands/balance.test.js\"",
    "test-create-wallet": "nyc mocha --forbid-only -t 50000 \"test/commands/create-wallet.test.js\"",
    "test-generate-lattice-keys": "nyc mocha --require test/hooks.js --forbid-only -t 50000 \"test/commands/generate-lattice-keys.test.js\"",
    "test-generate-shared-keys": "nyc mocha --require test/hooks.js --forbid-only -t 50000 \"test/commands/generate-shared-keys.test.js\"",
    "test-get-keys": "nyc mocha --forbid-only -t 50000 \"test/commands/get-keys.test.js\"",
    "test-list-transactions": "nyc mocha --forbid-only -t 50000 \"test/commands/list-transactions.test.js\"",
    "test-notarize": "nyc mocha --require test/hooks.js --forbid-only -t 50000 \"test/commands/notarize.test.js\"",
    "test-ots": "nyc mocha --forbid-only -t 50000 \"test/commands/ots.test.js\"",
    "test-receive": "nyc mocha --forbid-only -t 50000 \"test/commands/receive.test.js\"",
    "test-search": "nyc mocha --require test/hooks.js --forbid-only -t 50000 \"test/commands/search.test.js\"",
    "test-send-message": "nyc mocha --forbid-only -t 50000 \"test/commands/send-message.test.js\"",
    "test-send": "nyc mocha --require test/hooks.js --forbid-only -t 50000 \"test/commands/send.test.js\"",
    "test-status": "nyc mocha --forbid-only -t 50000 \"test/commands/status.test.js\"",
    "test-validate": "nyc mocha --forbid-only -t 50000 \"test/commands/validate.test.js\"",
    "version": "oclif-dev readme && git add README.md",
    "make-binaries": "pkg . --no-bytecode --public --public-packages '*' -t node24-macos-x64 -o dist/macos-x64/qrl-cli && pkg . --no-bytecode --public --public-packages '*' -t node24-macos-arm64 -o dist/macos-arm64/qrl-cli && pkg . --no-bytecode --public --public-packages '*' -t node24-linux-x64 -o dist/linux-x64/qrl-cli && pkg . --no-bytecode --public --public-packages '*' -t node24-linux-arm64 -o dist/linux-arm64/qrl-cli && pkg . --no-bytecode --public --public-packages '*' -t node24-win-x64 -o dist/win-x64/qrl-cli.exe && cp ./assets/macos/ecdh.node dist/macos-x64 && cp ./assets/linux/ecdh.node dist/linux-x64 && cp ./assets/win/ecdh.node dist/win-x64"
  },
  "pkg": {
    "scripts": [
      "src/**"
    ],
    "assets": [
      "node_modules/@theqrl/qrlbase.proto/**"
    ]
  },
  "overrides": {
    "secp256k1": "3.8.1",
    "elliptic": "6.6.1",
    "serialize-javascript": "7.0.7",
    "tmp": "0.2.7",
    "diff": "8.0.4"
  }
}
